@page "/tools/document-composer"
@rendermode InteractiveWebAssembly

@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms

@inject IJSRuntime JS

<PageTitle>Document Image Composer | Zaid MKA</PageTitle>

<div class="composer-page">

    <!-- =========================================
         HEADER
    ========================================== -->

    <div class="page-header">
        <div class="page-container header-inner">

            <div>
                <div class="breadcrumb">
                    <a href="/">Home</a>
                    <span>/</span>
                    <a href="/tools">Tools</a>
                    <span>/</span>
                    <span>Document Composer</span>
                </div>

                <div class="title-row">

                    <div class="title-icon">
                        <i class="bi bi-file-earmark-image"></i>
                    </div>

                    <div>
                        <h1>Document Image Composer</h1>

                        <p>
                            Arrange document images automatically on a clean A4 page.
                        </p>
                    </div>

                </div>
            </div>

            <div class="privacy-card">
                <div class="privacy-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <strong>Privacy first</strong>
                    <span>Your images stay in your browser.</span>
                </div>
            </div>

        </div>
    </div>


    <!-- =========================================
         MOBILE INTRO
    ========================================== -->

    <div class="mobile-intro page-container">

        <div class="mobile-intro-icon">
            <i class="bi bi-files"></i>
        </div>

        <div class="mobile-intro-content">

            <span class="mobile-eyebrow">
                QUICK DOCUMENT COMPOSER
            </span>

            <h2>رتّب مستمسكاتك للطباعة</h2>

            <p>
                ارفع الوجه والظهر للمستمسكات المطلوبة،
                ونحن نرتبها تلقائياً على صفحة A4 جاهزة.
            </p>

        </div>

        <div class="mobile-steps">

            <div class="mobile-step">
                <span>1</span>
                <strong>اختر المستمسك</strong>
            </div>

            <i class="bi bi-chevron-left"></i>

            <div class="mobile-step">
                <span>2</span>
                <strong>ارفع الصور</strong>
            </div>

            <i class="bi bi-chevron-left"></i>

            <div class="mobile-step">
                <span>3</span>
                <strong>نزّل PDF</strong>
            </div>

        </div>

        <div class="mobile-privacy">
            <i class="bi bi-shield-lock"></i>

            <span>
                الصور تبقى على جهازك ولا يتم رفعها أو تخزينها على السيرفر.
            </span>
        </div>

    </div>


    <!-- =========================================
         MAIN
    ========================================== -->

    <div class="page-container composer-layout">

        <!-- =====================================
             CONTROL PANEL
        ====================================== -->

        <aside class="control-panel">

            <div class="panel-section">

                <div class="section-title">

                    <span class="number">01</span>

                    <div>
                        <h2>Upload Documents</h2>
                        <p>ارفع صور المستمسكات المطلوبة فقط</p>
                    </div>

                </div>


                @foreach (var document in Documents)
                {
                    <div class="@GetDocumentCardClass(document)">

                        <div class="document-card-header">

                            <div class="document-name">

                                <div class="document-icon">
                                    @document.ShortCode
                                </div>

                                <div class="document-title">

                                    <span class="doc-ar"
                                          dir="rtl">
                                        @document.ArabicName
                                    </span>

                                    @if (document.HasAnyImage)
                                    {
                                        <span class="document-complete-indicator">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </span>
                                    }

                                </div>

                            </div>


                            @if (document.HasAnyImage)
                            {
                                <button type="button"
                                        class="clear-document"
                                        title="Clear document"
                                        @onclick="() => ClearDocument(document)">

                                    <i class="bi bi-x-lg"></i>

                                </button>
                            }

                        </div>


                        <div class="side-upload-grid">

                            <!-- FRONT -->

                            <div class="@GetUploadClass(document.FrontImage)">

                                @if (document.FrontImage is null)
                                {
                                    <label class="upload-label">

                                        <InputFile OnChange="e => LoadImage(e, document, DocumentSide.Front)"
                                                   accept="image/jpeg,image/png,image/webp" />

                                        <div class="upload-symbol">
                                            <i class="bi bi-plus-lg"></i>
                                        </div>

                                        <strong>Front</strong>
                                        <span>الوجه</span>

                                        <small>
                                            JPG / PNG / WEBP
                                        </small>

                                    </label>
                                }
                                else
                                {
                                    <div class="uploaded-preview">

                                        <img src="@document.FrontImage.DataUrl"
                                             alt="@($"{document.EnglishName} front")" />

                                        <div class="image-overlay">

                                            <label class="replace-image">

                                                Replace

                                                <InputFile OnChange="e => LoadImage(e, document, DocumentSide.Front)"
                                                           accept="image/jpeg,image/png,image/webp" />

                                            </label>

                                            <button type="button"
                                                    @onclick="() => RemoveImage(document, DocumentSide.Front)">
                                                Remove
                                            </button>

                                        </div>


                                        <div class="mobile-uploaded-state">

                                            <div class="mobile-uploaded-title">

                                                <i class="bi bi-check-circle-fill"></i>

                                                <div>
                                                    <strong>الوجه</strong>
                                                    <span>تم رفع الصورة</span>
                                                </div>

                                            </div>


                                            <div class="mobile-image-actions">

                                                <label>

                                                    <i class="bi bi-arrow-repeat"></i>
                                                    تغيير

                                                    <InputFile OnChange="e => LoadImage(e, document, DocumentSide.Front)"
                                                               accept="image/jpeg,image/png,image/webp" />

                                                </label>


                                                <button type="button"
                                                        @onclick="() => RemoveImage(document, DocumentSide.Front)">

                                                    <i class="bi bi-trash3"></i>
                                                    حذف

                                                </button>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>


                            <!-- BACK -->

                            <div class="@GetUploadClass(document.BackImage)">

                                @if (document.BackImage is null)
                                {
                                    <label class="upload-label">

                                        <InputFile OnChange="e => LoadImage(e, document, DocumentSide.Back)"
                                                   accept="image/jpeg,image/png,image/webp" />

                                        <div class="upload-symbol">
                                            <i class="bi bi-plus-lg"></i>
                                        </div>

                                        <strong>Back</strong>
                                        <span>الظهر</span>

                                        <small>
                                            JPG / PNG / WEBP
                                        </small>

                                    </label>
                                }
                                else
                                {
                                    <div class="uploaded-preview">

                                        <img src="@document.BackImage.DataUrl"
                                             alt="@($"{document.EnglishName} back")" />

                                        <div class="image-overlay">

                                            <label class="replace-image">

                                                Replace

                                                <InputFile OnChange="e => LoadImage(e, document, DocumentSide.Back)"
                                                           accept="image/jpeg,image/png,image/webp" />

                                            </label>

                                            <button type="button"
                                                    @onclick="() => RemoveImage(document, DocumentSide.Back)">
                                                Remove
                                            </button>

                                        </div>


                                        <div class="mobile-uploaded-state">

                                            <div class="mobile-uploaded-title">

                                                <i class="bi bi-check-circle-fill"></i>

                                                <div>
                                                    <strong>الظهر</strong>
                                                    <span>تم رفع الصورة</span>
                                                </div>

                                            </div>


                                            <div class="mobile-image-actions">

                                                <label>

                                                    <i class="bi bi-arrow-repeat"></i>
                                                    تغيير

                                                    <InputFile OnChange="e => LoadImage(e, document, DocumentSide.Back)"
                                                               accept="image/jpeg,image/png,image/webp" />

                                                </label>


                                                <button type="button"
                                                        @onclick="() => RemoveImage(document, DocumentSide.Back)">

                                                    <i class="bi bi-trash3"></i>
                                                    حذف

                                                </button>

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>


            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="error-message">

                    <i class="bi bi-exclamation-triangle"></i>

                    @ErrorMessage

                </div>
            }


            <button type="button"
                    class="reset-button"
                    disabled="@(!HasAnyDocument)"
                    @onclick="ResetAll">

                <i class="bi bi-arrow-counterclockwise"></i>

                Reset all

            </button>

        </aside>


        <!-- =====================================
             REAL A4 PREVIEW
             هذا هو العنصر الوحيد المستخدم للتصدير
        ====================================== -->

        <main class="preview-area desktop-preview">

            <div class="preview-heading">

                <div>

                    <span class="preview-label">
                        LIVE PREVIEW
                    </span>

                    <h2>A4 Preview</h2>

                    <p>
                        معاينة مباشرة قبل الطباعة
                    </p>

                </div>


                <div class="preview-meta">

                    <span>
                        @SelectedDocumentCount
                        @(SelectedDocumentCount == 1 ? "document" : "documents")
                    </span>

                    <span class="meta-divider"></span>

                    <span>
                        A4 Portrait
                    </span>

                </div>

            </div>


            <div class="paper-stage">

                <div id="document-a4-preview"
                     class="a4-paper portrait">

                    @if (!HasAnyDocument)
                    {
                        <div class="empty-paper">

                            <div class="empty-icon">
                                <i class="bi bi-file-earmark-image"></i>
                            </div>

                            <h3>Your A4 preview will appear here</h3>

                            <p>
                                Upload the front or back image of any document
                                to start building your page.
                            </p>

                            <span>
                                يمكنك رفع مستمسك واحد أو أكثر
                            </span>

                        </div>
                    }
                    else
                    {
                        <div class="@GetPaperContentClass()">

                            @foreach (var document in SelectedDocuments)
                            {
                                <section class="paper-document">

                                    @if (_showLabels)
                                    {
                                        <div class="paper-document-title">

                                            <strong>
                                                @document.EnglishName - @document.ArabicName
                                            </strong>

                                        </div>
                                    }


                                    <div class="@GetSidesClass()">

                                        @if (document.FrontImage is not null)
                                        {
                                            <div class="paper-side">

                                                <div class="@GetImageFrameClass(document.FrontImage)">

                                                    <img src="@document.FrontImage.DataUrl"
                                                         alt="Front" />

                                                </div>

                                            </div>
                                        }


                                        @if (document.BackImage is not null)
                                        {
                                            <div class="paper-side">

                                                <div class="@GetImageFrameClass(document.BackImage)">

                                                    <img src="@document.BackImage.DataUrl"
                                                         alt="Back" />

                                                </div>

                                            </div>
                                        }

                                    </div>

                                </section>
                            }

                        </div>
                    }


                    <div class="paper-footer">
                        zaidmka.com • Document Image Composer
                    </div>

                </div>

            </div>


            <div class="privacy-note">

                <div class="privacy-note-icon">
                    <i class="bi bi-check-lg"></i>
                </div>

                <div>

                    <strong>
                        Browser-only processing
                    </strong>

                    <p>
                        Images are loaded directly into your browser.
                        Nothing is uploaded or stored on the server.
                    </p>

                </div>

            </div>


            <div class="export-bar">

                <div class="export-info">

                    <strong>
                        Ready for export
                    </strong>

                    <span>
                        Your documents are automatically arranged on A4.
                    </span>

                </div>


                <div class="export-actions">

                    <button type="button"
                            disabled="@(!HasAnyDocument)"
                            @onclick="DownloadPng">

                        <i class="bi bi-image"></i>
                        Download PNG

                    </button>


                    <button type="button"
                            class="primary-export"
                            disabled="@(!HasAnyDocument)"
                            @onclick="DownloadPdf">

                        <i class="bi bi-file-earmark-pdf"></i>
                        Download PDF

                    </button>

                </div>

            </div>

        </main>

    </div>


    <!-- =========================================
         MOBILE PREVIEW BUTTON
    ========================================== -->
    @if (HasAnyDocument)
    {
        <div class="mobile-preview-section page-container">

            <button type="button"
                    class="mobile-preview-button"
                    @onclick="OpenMobilePreview">

                <div>

                    <i class="bi bi-eye"></i>

                    <span>
                        <strong>معاينة الصفحة</strong>
                        <small>اختياري — شاهد ترتيب A4 قبل التحميل</small>
                    </span>

                </div>

                <i class="bi bi-chevron-left"></i>

            </button>

        </div>
    }


    <!-- =========================================
         MOBILE PREVIEW MODAL
         مجرد preview بصري، مو عنصر التصدير
    ========================================== -->
    @if (_showMobilePreview)
    {
        <div class="mobile-preview-modal">

            <div class="mobile-preview-backdrop"
                 @onclick="CloseMobilePreview">
            </div>


            <div class="mobile-preview-sheet">

                <div class="mobile-sheet-header">

                    <div>
                        <span>A4 PREVIEW</span>

                        <h3>
                            معاينة الصفحة
                        </h3>
                    </div>


                    <button type="button"
                            @onclick="CloseMobilePreview">

                        <i class="bi bi-x-lg"></i>

                    </button>

                </div>


                <div class="mobile-paper-stage">

                    <div class="mobile-paper-scale">

                        <div class="paper-stage">

                            <div class="a4-paper portrait">

                                @if (HasAnyDocument)
                                {
                                    <div class="@GetPaperContentClass()">

                                        @foreach (var document in SelectedDocuments)
                                        {
                                            <section class="paper-document">

                                                @if (_showLabels)
                                                {
                                                    <div class="paper-document-title">

                                                        <strong>
                                                            @document.EnglishName - @document.ArabicName
                                                        </strong>

                                                    </div>
                                                }


                                                <div class="@GetSidesClass()">

                                                    @if (document.FrontImage is not null)
                                                    {
                                                        <div class="paper-side">

                                                            <div class="@GetImageFrameClass(document.FrontImage)">

                                                                <img src="@document.FrontImage.DataUrl"
                                                                     alt="Front" />

                                                            </div>

                                                        </div>
                                                    }


                                                    @if (document.BackImage is not null)
                                                    {
                                                        <div class="paper-side">

                                                            <div class="@GetImageFrameClass(document.BackImage)">

                                                                <img src="@document.BackImage.DataUrl"
                                                                     alt="Back" />

                                                            </div>

                                                        </div>
                                                    }

                                                </div>

                                            </section>
                                        }

                                    </div>
                                }


                                <div class="paper-footer">
                                    zaidmka.com • Document Image Composer
                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="mobile-sheet-actions">

                    <button type="button"
                            class="mobile-sheet-close"
                            @onclick="CloseMobilePreview">

                        رجوع

                    </button>


                    <button type="button"
                            class="mobile-sheet-download"
                            @onclick="DownloadPdf">

                        <i class="bi bi-download"></i>

                        تحميل PDF

                    </button>

                </div>

            </div>

        </div>
    }


    <!-- =========================================
         MOBILE BOTTOM ACTION BAR
    ========================================== -->
    @if (HasAnyDocument)
    {
        <div class="mobile-export-bar">

            <div class="mobile-export-inner">

                <div class="mobile-export-status">

                    <div class="mobile-export-check">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <div>

                        <strong>
                            @UploadedImageCount
                            @(UploadedImageCount == 1 ? "صورة جاهزة" : "صور جاهزة")
                        </strong>

                        <span>
                            مرتبة تلقائياً على A4
                        </span>

                    </div>

                </div>


                <button type="button"
                        class="mobile-download-button"
                        @onclick="DownloadPdf">

                    <i class="bi bi-file-earmark-arrow-down"></i>

                    تحميل PDF

                </button>

            </div>

        </div>
    }

</div>


@code {

    private const long MaxImageSize =
        12 * 1024 * 1024;


    private readonly List<DocumentItem> Documents =
    [
        new()
        {
            Id = "national",
            ArabicName = "البطاقة الوطنية الموحدة",
            EnglishName = "National ID Card",
            ShortCode = "ID"
        },

        new()
        {
            Id = "government",
            ArabicName = "الهوية الحكومية",
            EnglishName = "Government ID",
            ShortCode = "GV"
        },

        new()
        {
            Id = "green-zone",
            ArabicName = "هوية المنطقة الخضراء",
            EnglishName = "Green Zone ID",
            ShortCode = "GZ"
        },

        new()
        {
            Id = "residence",
            ArabicName = "بطاقة السكن",
            EnglishName = "Residence Card",
            ShortCode = "RC"
        }
    ];


    private LayoutMode _layoutMode =
        LayoutMode.SideBySide;


    private bool _showLabels = true;

    private bool _showMobilePreview;

    private string? ErrorMessage;


    private IEnumerable<DocumentItem> SelectedDocuments =>
        Documents.Where(x => x.HasAnyImage);


    private bool HasAnyDocument =>
        Documents.Any(x => x.HasAnyImage);


    private int SelectedDocumentCount =>
        Documents.Count(x => x.HasAnyImage);


    private int UploadedImageCount =>
        Documents.Sum(x =>
            (x.FrontImage is not null ? 1 : 0) +
            (x.BackImage is not null ? 1 : 0));


    private async Task LoadImage(
        InputFileChangeEventArgs e,
        DocumentItem document,
        DocumentSide side)
    {
        ErrorMessage = null;

        try
        {
            var file = e.File;

            if (file is null)
                return;


            if (!file.ContentType.StartsWith(
                    "image/",
                    StringComparison.OrdinalIgnoreCase))
            {
                ErrorMessage =
                    "Please select a valid image file.";

                return;
            }


            if (file.Size > MaxImageSize)
            {
                ErrorMessage =
                    "Image size must be 12 MB or less.";

                return;
            }


            await using var stream =
                file.OpenReadStream(MaxImageSize);


            using var memoryStream =
                new MemoryStream();


            await stream.CopyToAsync(memoryStream);


            var base64 =
                Convert.ToBase64String(
                    memoryStream.ToArray());


            var image =
                new UploadedImage
                {
                    FileName = file.Name,

                    DataUrl =
                        $"data:{file.ContentType};base64,{base64}"
                };


            var dimensions =
                await JS.InvokeAsync<ImageDimensions>(
                    "zaidTools.getImageDimensions",
                    image.DataUrl);


            image.Width =
                dimensions.Width;

            image.Height =
                dimensions.Height;

            image.IsPortrait =
                dimensions.IsPortrait;


            var crop =
                await JS.InvokeAsync<AutoCropResult>(
                    "zaidTools.autoCropDocument",
                    image.DataUrl);


            if (crop.Success)
            {
                image.DataUrl =
                    crop.DataUrl;

                image.Width =
                    crop.Width;

                image.Height =
                    crop.Height;

                image.IsPortrait =
                    crop.Height > crop.Width;

                image.IsCropped =
                    true;
            }


            if (side == DocumentSide.Front)
            {
                document.FrontImage =
                    image;
            }
            else
            {
                document.BackImage =
                    image;
            }
        }
        catch
        {
            ErrorMessage =
                "The image could not be loaded.";
        }
    }


    private void RemoveImage(
        DocumentItem document,
        DocumentSide side)
    {
        if (side == DocumentSide.Front)
        {
            document.FrontImage =
                null;
        }
        else
        {
            document.BackImage =
                null;
        }
    }


    private void ClearDocument(
        DocumentItem document)
    {
        document.FrontImage =
            null;

        document.BackImage =
            null;
    }


    private void ResetAll()
    {
        foreach (var document in Documents)
        {
            document.FrontImage =
                null;

            document.BackImage =
                null;
        }

        _layoutMode =
            LayoutMode.SideBySide;

        _showLabels =
            true;

        _showMobilePreview =
            false;

        ErrorMessage =
            null;
    }


    private void OpenMobilePreview()
    {
        _showMobilePreview =
            true;
    }


    private void CloseMobilePreview()
    {
        _showMobilePreview =
            false;
    }


    private string GetDocumentCardClass(
        DocumentItem document)
    {
        return document.HasAnyImage
            ? "document-card has-images"
            : "document-card";
    }


    private string GetUploadClass(
        UploadedImage? image)
    {
        return image is null
            ? "upload-box"
            : "upload-box has-image";
    }


    private string GetPaperContentClass()
    {
        return SelectedDocumentCount switch
        {
            1 => "paper-content document-count-1",
            2 => "paper-content document-count-2",
            3 => "paper-content document-count-3",
            _ => "paper-content document-count-4"
        };
    }


    private string GetSidesClass()
    {
        return _layoutMode == LayoutMode.SideBySide
            ? "paper-sides side-by-side"
            : "paper-sides stacked";
    }


    private string GetImageFrameClass(
        UploadedImage image)
    {
        return image.IsPortrait
            ? "paper-image-frame portrait-image"
            : "paper-image-frame landscape-image";
    }


    private async Task DownloadPng()
    {
        if (!HasAnyDocument)
            return;


        await JS.InvokeAsync<bool>(
            "zaidTools.downloadElementAsPng",
            "document-a4-preview",
            "documents-a4.png");
    }


    private async Task DownloadPdf()
    {
        if (!HasAnyDocument)
            return;


        await JS.InvokeAsync<bool>(
            "zaidTools.downloadElementAsPdf",
            "document-a4-preview",
            "documents-a4.pdf",
            false);
    }


    private sealed class ImageDimensions
    {
        public int Width { get; set; }

        public int Height { get; set; }

        public bool IsPortrait { get; set; }
    }


    private sealed class AutoCropResult
    {
        public bool Success { get; set; }

        public string DataUrl { get; set; } =
            string.Empty;

        public int Width { get; set; }

        public int Height { get; set; }
    }


    private sealed class DocumentItem
    {
        public string Id { get; set; } =
            string.Empty;

        public string ArabicName { get; set; } =
            string.Empty;

        public string EnglishName { get; set; } =
            string.Empty;

        public string ShortCode { get; set; } =
            string.Empty;

        public UploadedImage? FrontImage { get; set; }

        public UploadedImage? BackImage { get; set; }

        public bool HasAnyImage =>
            FrontImage is not null ||
            BackImage is not null;
    }


    private sealed class UploadedImage
    {
        public string FileName { get; set; } =
            string.Empty;

        public string DataUrl { get; set; } =  string.Empty;

        public int Width { get; set; }

        public int Height { get; set; }

        public bool IsPortrait { get; set; }

        public bool IsCropped { get; set; }
    }


    private enum DocumentSide
    {
        Front,
        Back
    }


    private enum LayoutMode
    {
        SideBySide,
        Stacked
    }
}