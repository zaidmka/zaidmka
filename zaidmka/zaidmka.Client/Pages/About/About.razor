@page "/about"
@rendermode InteractiveWebAssembly

<PageTitle>About | Zaid MKA</PageTitle>

<div class="about-page" dir="@(_arabic ? "rtl" : "ltr")">

    <div class="about-container language-row">
        <div class="language-switch">

            <button type="button"
                    class="@(!_arabic ? "active" : "")"
                    @onclick="() => _arabic = false">
                English
            </button>

            <button type="button"
                    class="@(_arabic ? "active" : "")"
                    @onclick="() => _arabic = true">
                العربية
            </button>

        </div>
    </div>

    @if (_arabic)
    {
        @ArabicContent
    }
    else
    {
        @EnglishContent
    }

</div>


