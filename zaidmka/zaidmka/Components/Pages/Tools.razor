@page "/tools"

<PageTitle>Free Online Tools | Zaid MKA</PageTitle>

<div class="tools-page">

    <!-- =========================
         HERO
    ========================== -->

    <section class="tools-hero">

        <div class="hero-glow glow-one"></div>
        <div class="hero-glow glow-two"></div>

        <div class="tools-hero-content">

            <div class="tools-brand-badge">
                <i class="bi bi-braces-asterisk"></i>
                <span>ZAID MKA TOOLS</span>
            </div>

            <h1>
                أدوات بسيطة.
                <span>نتائج أسرع.</span>
            </h1>

            <p class="hero-description">
                مجموعة أدوات مجانية للمطورين، المستندات والصور.
                سريعة، بسيطة، ومصممة لإنجاز المهام اليومية مباشرة من المتصفح.
            </p>

            <div class="hero-features">

                <div>
                    <i class="bi bi-lightning-charge-fill"></i>
                    سريعة
                </div>

                <div>
                    <i class="bi bi-shield-check"></i>
                    Privacy First
                </div>

                <div>
                    <i class="bi bi-browser-chrome"></i>
                    تعمل من المتصفح
                </div>

                <div>
                    <i class="bi bi-infinity"></i>
                    مجانية
                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         DEVELOPER TOOLS
    ========================== -->

    <section class="tools-section">

        <div class="section-header">

            <div class="section-title">

                <div class="section-icon developer">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div>
                    <span class="section-kicker">DEVELOPER TOOLS</span>
                    <h2>أدوات المطور</h2>
                    <p>أدوات صغيرة للمهام التي نحتاجها كل يوم.</p>
                </div>

            </div>

            <div class="tools-count">
                5 أدوات
            </div>

        </div>


        <div class="tools-grid">


            <!-- JSON FORMATTER -->

            <a href="/tools/json"
               class="tool-card">

                <div class="tool-top">

                    <div class="tool-icon json">
                        <i class="bi bi-braces"></i>
                    </div>

                    <span class="status available">
                        <span></span>
                        Available
                    </span>

                </div>

                <div class="tool-body">

                    <div class="tool-category">
                        JSON
                    </div>

                    <h3>JSON Formatter</h3>

                    <p>
                        تنسيق وفحص JSON وتحويل البيانات غير المرتبة
                        إلى صيغة واضحة وسهلة القراءة.
                    </p>

                </div>

                <div class="tool-action">
                    فتح الأداة
                    <i class="bi bi-arrow-left"></i>
                </div>

            </a>


            <!-- JWT DECODER -->

            <a href="/tools/jwt"
               class="tool-card">

                <div class="tool-top">

                    <div class="tool-icon jwt">
                        <i class="bi bi-key"></i>
                    </div>

                    <span class="status available">
                        <span></span>
                        Available
                    </span>

                </div>

                <div class="tool-body">

                    <div class="tool-category">
                        SECURITY
                    </div>

                    <h3>JWT Decoder</h3>

                    <p>
                        فك Header و Payload للـ JWT Token
                        وعرض محتوياته بشكل مرتب وسريع.
                    </p>

                </div>

                <div class="tool-action">
                    فتح الأداة
                    <i class="bi bi-arrow-left"></i>
                </div>

            </a>


            <!-- GUID -->

            <a href="/tools/guid"
               class="tool-card">

                <div class="tool-top">

                    <div class="tool-icon guid">
                        <i class="bi bi-fingerprint"></i>
                    </div>

                    <span class="status available">
                        <span></span>
                        Available
                    </span>

                </div>

                <div class="tool-body">

                    <div class="tool-category">
                        GENERATOR
                    </div>

                    <h3>GUID Generator</h3>

                    <p>
                        إنشاء UUID / GUID جديد فوراً
                        مع إمكانية النسخ وتوليد مجموعة دفعة واحدة.
                    </p>

                </div>

                <div class="tool-action">
                    فتح الأداة
                    <i class="bi bi-arrow-left"></i>
                </div>

            </a>


            <!-- BASE64 -->

            <a href="/tools/base64"
               class="tool-card">

                <div class="tool-top">

                    <div class="tool-icon base64">
                        <i class="bi bi-file-earmark-code"></i>
                    </div>

                    <span class="status available">
                        <span></span>
                        Available
                    </span>

                </div>

                <div class="tool-body">

                    <div class="tool-category">
                        ENCODE / DECODE
                    </div>

                    <h3>Base64 Tool</h3>

                    <p>
                        تحويل النصوص والبيانات إلى Base64
                        أو فكها بسرعة من داخل المتصفح.
                    </p>

                </div>

                <div class="tool-action">
                    فتح الأداة
                    <i class="bi bi-arrow-left"></i>
                </div>

            </a>


            <!-- QR -->

            <a href="/tools/qr"
               class="tool-card">

                <div class="tool-top">

                    <div class="tool-icon qr">
                        <i class="bi bi-qr-code"></i>
                    </div>

                    <span class="status available">
                        <span></span>
                        Available
                    </span>

                </div>

                <div class="tool-body">

                    <div class="tool-category">
                        GENERATOR
                    </div>

                    <h3>QR Generator</h3>

                    <p>
                        إنشاء QR Code للنصوص والروابط
                        بسرعة مع إمكانية حفظ الصورة.
                    </p>

                </div>

                <div class="tool-action">
                    فتح الأداة
                    <i class="bi bi-arrow-left"></i>
                </div>

            </a>


            <!-- MORE -->

            <div class="tool-card more-card">

                <div class="more-content">

                    <div class="more-icon">
                        <i class="bi bi-plus-lg"></i>
                    </div>

                    <h3>More Developer Tools</h3>

                    <p>
                        المزيد من الأدوات الصغيرة
                        والمفيدة قادمة قريباً.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         DOCUMENT TOOLS
    ========================== -->

    <section class="tools-section document-section">

        <div class="section-header">

            <div class="section-title">

                <div class="section-icon document">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <div>
                    <span class="section-kicker">DOCUMENT TOOLS</span>
                    <h2>أدوات المستندات</h2>
                    <p>تجهيز المستندات للطباعة والاستخدام اليومي.</p>
                </div>

            </div>

        </div>


        <!-- FEATURED TOOL -->

        <a href="/tools/document-composer"
           class="featured-tool">

            <div class="featured-decoration"></div>

            <div class="featured-content">

                <div class="featured-top">

                    <div class="featured-icon">
                        <i class="bi bi-file-earmark-image"></i>
                    </div>

                    <div class="featured-badges">

                        <span class="featured-badge">
                            <i class="bi bi-stars"></i>
                            FEATURED
                        </span>

                        <span class="status available dark-status">
                            <span></span>
                            Available
                        </span>

                    </div>

                </div>


                <div class="featured-category">
                    DOCUMENT COMPOSER
                </div>

                <h3>Document Image Composer</h3>

                <p>
                    جهّز صور الهويات والمستندات على صفحة A4
                    بطريقة مرتبة وجاهزة للطباعة.
                    أضف الوجه والظهر، اختر اتجاه الصفحة
                    وشاهد النتيجة مباشرة قبل الحفظ.
                </p>


                <div class="featured-features">

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Front & Back
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        A4 Live Preview
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Portrait / Landscape
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill"></i>
                        Browser Processing
                    </div>

                </div>


                <div class="featured-action">

                    <span>
                        فتح Document Composer
                    </span>

                    <div>
                        <i class="bi bi-arrow-left"></i>
                    </div>

                </div>

            </div>


            <div class="featured-preview">

                <div class="paper-preview">

                    <div class="paper-line small"></div>

                    <div class="fake-document">

                        <div class="fake-photo">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div class="fake-data">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                    </div>

                    <div class="fake-document second">

                        <div class="fake-data full">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>

                    </div>

                </div>

            </div>

        </a>

    </section>


    <!-- =========================
         IMAGE TOOLS
    ========================== -->

    <section class="tools-section">

        <div class="section-header">

            <div class="section-title">

                <div class="section-icon images">
                    <i class="bi bi-images"></i>
                </div>

                <div>
                    <span class="section-kicker">IMAGE TOOLS</span>
                    <h2>أدوات الصور</h2>
                    <p>معالجة وتجهيز الصور بسرعة ومن داخل المتصفح.</p>
                </div>

            </div>

            <span class="development-label">
                <i class="bi bi-hammer"></i>
                In Development
            </span>

        </div>


        <div class="tools-grid image-tools-grid">


            <!-- SMART CROP -->

            <div class="tool-card coming-card">

                <div class="tool-top">

                    <div class="tool-icon crop">
                        <i class="bi bi-crop"></i>
                    </div>

                    <span class="status development">
                        In Development
                    </span>

                </div>

                <div class="tool-body">

                    <div class="tool-category">
                        DOCUMENT IMAGE
                    </div>

                    <h3>Smart Document Crop</h3>

                    <p>
                        اكتشاف حدود المستند داخل الصورة
                        وقص الخلفية للحصول على صورة أنظف.
                    </p>

                </div>

                <div class="coming-footer">
                    قريباً
                </div>

            </div>


            <!-- COMPRESS -->

            <div class="tool-card coming-card">

                <div class="tool-top">

                    <div class="tool-icon compress">
                        <i class="bi bi-arrows-collapse"></i>
                    </div>

                    <span class="status soon">
                        Coming Soon
                    </span>

                </div>

                <div class="tool-body">

                    <div class="tool-category">
                        OPTIMIZATION
                    </div>

                    <h3>Image Compressor</h3>

                    <p>
                        تقليل حجم الصور مع المحافظة
                        قدر الإمكان على جودة الصورة الأصلية.
                    </p>

                </div>

                <div class="coming-footer">
                    قريباً
                </div>

            </div>


            <!-- RESIZE -->

            <div class="tool-card coming-card">

                <div class="tool-top">

                    <div class="tool-icon resize">
                        <i class="bi bi-aspect-ratio"></i>
                    </div>

                    <span class="status soon">
                        Coming Soon
                    </span>

                </div>

                <div class="tool-body">

                    <div class="tool-category">
                        IMAGE SIZE
                    </div>

                    <h3>Image Resizer</h3>

                    <p>
                        تغيير أبعاد الصور بالبكسل أو النسبة
                        مع الحفاظ على Aspect Ratio.
                    </p>

                </div>

                <div class="coming-footer">
                    قريباً
                </div>

            </div>


            <!-- IMAGE TO PDF -->

            <div class="tool-card coming-card">

                <div class="tool-top">

                    <div class="tool-icon image-pdf">
                        <i class="bi bi-file-earmark-pdf"></i>
                    </div>

                    <span class="status soon">
                        Coming Soon
                    </span>

                </div>

                <div class="tool-body">

                    <div class="tool-category">
                        CONVERTER
                    </div>

                    <h3>Image to PDF</h3>

                    <p>
                        دمج صورة أو مجموعة صور
                        وتحويلها إلى ملف PDF مرتب.
                    </p>

                </div>

                <div class="coming-footer">
                    قريباً
                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         PRIVACY
    ========================== -->

    <section class="privacy-section">

        <div class="privacy-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <div class="privacy-content">

            <span>PRIVACY FIRST</span>

            <h3>ملفاتك تبقى عندك.</h3>

            <p>
                الأدوات التي تدعم المعالجة المحلية تنفذ عملياتها
                داخل متصفحك دون الحاجة إلى رفع ملفاتك إلى الخادم.
            </p>

        </div>

        <div class="privacy-decoration">
            <i class="bi bi-browser-chrome"></i>
            <span></span>
            <i class="bi bi-cpu"></i>
            <span></span>
            <i class="bi bi-check-lg"></i>
        </div>

    </section>


    <!-- =========================
         FOOT NOTE
    ========================== -->

    <div class="tools-footer-note">

        <i class="bi bi-stars"></i>

        <span>
            Zaid MKA Tools مستمرة بالتطور —
            المزيد من الأدوات قريباً.
        </span>

    </div>

</div>